{
  "name": "@vdoninja/sdk",
  "version": "1.6.0",
  "description": "AI-friendly P2P communication SDK for audio, video, and data. Includes WHIP/WHEP clients for publishing to Twitch, Meshcast, Cloudflare Stream",
  "main": "vdoninja-sdk.js",
  "browser": "vdoninja-sdk.js",
  "types": "./vdoninja-sdk.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./vdoninja-sdk.d.ts",
        "default": "./vdoninja-sdk.js"
      },
      "node": {
        "types": "./vdoninja-sdk-node.d.ts",
        "default": "./vdoninja-sdk-node.js"
      },
      "types": "./vdoninja-sdk.d.ts",
      "default": "./vdoninja-sdk.js"
    },
    "./node": {
      "types": "./vdoninja-sdk-node.d.ts",
      "default": "./vdoninja-sdk-node.js"
    },
    "./browser": {
      "types": "./vdoninja-sdk.d.ts",
      "default": "./vdoninja-sdk.js"
    },
    "./whip": "./whip-client.js",
    "./whep": "./whep-client.js"
  },
  "scripts": {
    "build": "npm run minify && npm run docs:build",
    "docs:build": "node scripts/build-docs.cjs",
    "test:docs": "node --test tests/docs.test.cjs",
    "minify": "terser vdoninja-sdk.js -o vdoninja-sdk.min.js --compress --mangle --comments \"/VDO.Ninja SDK v/\"",
    "watch": "chokidar \"vdoninja-sdk.js\" -c \"npm run build\"",
    "test": "node run-all-tests.js",
    "test:types": "tsc --noEmit --strict --lib es2020 --module node16 --moduleResolution node16 tests/types/consumer.ts tests/types/node-consumer.ts",
    "test:reliability": "node --test tests/sdk-reliability.test.js tests/sdk-review.test.js",
    "test:node": "node demos/node-example.js",
    "test:all": "node run-all-tests.js",
    "check:webrtc": "node -e \"console.log(require('./vdoninja-sdk-node.js').checkWebRTCSupport())\"",
    "ssn:listen": "node demos/socialstreamninja-listener.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveseguin/ninjasdk.git"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "peer-to-peer",
    "video",
    "audio",
    "streaming",
    "vdo.ninja",
    "ai-friendly",
    "data-channel",
    "whip",
    "whep",
    "twitch",
    "meshcast",
    "cloudflare-stream",
    "webrtc-http"
  ],
  "author": "Steve Seguin",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/steveseguin/ninjasdk/issues"
  },
  "homepage": "https://github.com/steveseguin/ninjasdk#readme",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "markdown-it": "^14.3.1",
    "terser": "^5.31.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@roamhq/wrtc": ">=0.8.0",
    "node-datachannel": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "node-datachannel": {
      "optional": true
    }
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "ws": "^8.21.1"
  }
}
